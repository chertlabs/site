{
  "name": "chertlabs-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@tschk/moonshine": "^0.4.49",
    "@tschk/moonshine-router": "^0.4.49",
    "@tschk/moonshine-server": "^0.4.49",
    "@tschk/moonshine-waku": "^0.4.49",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@unocss/core": "^66.12.0",
    "@unocss/preset-wind4": "^66.12.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "dev": "bun --watch src/server.tsx",
    "start": "bun src/server.tsx",
    "build": "bun scripts/build.ts",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run build"
  }
}
