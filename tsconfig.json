{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "types": ["bun", "react", "react-dom"],
    "paths": {
      "waku/router/client": [
        "./node_modules/@tschk/moonshine-waku/src/index.ts"
      ]
    }
  },
  "include": ["src/**/*", "scripts/**/*"]
}
